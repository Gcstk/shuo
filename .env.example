# Server
PORT=3040
DRAIN_TIMEOUT=300
DEBUG_MODE=False

# Browser mode essentials
# Fill these to use http://localhost:3040/web

# Turn / Speech service
TURN_PROVIDER=flux

# Deepgram Flux mode
DEEPGRAM_API_KEY=your_deepgram_api_key

# SoulX-Duplug remote mode
# TURN_PROVIDER=duplug
# DUPLUG_WS_URL=ws://your-duplug-host:8000/turn
# DUPLUG_WS_TIMEOUT=10

# LLM
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=http://your-openai-compatible-endpoint/v1
LLM_MODEL=your-model-name

# Optional alternates used by the current codebase
VLLM_API_KEY=
VLLM_BASE_URL=
GROQ_API_KEY=
OPENAI_API_KEY=

# Text-to-Speech
TTS_PROVIDER=qwen

# Qwen / DashScope realtime TTS
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_TTS_MODEL=qwen3-tts-flash-realtime-2025-11-27
QWEN_TTS_VOICE=Cherry
QWEN_TTS_LANGUAGE=Chinese
QWEN_TTS_MODE=commit
QWEN_TTS_SAMPLE_RATE=24000

# ElevenLabs fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Twilio phone mode only
# Only needed when running: python main.py +1234567890
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
# an ngrok public URL can be used as well which can be configured at https://dashboard.ngrok.com/domains
TWILIO_PUBLIC_URL=https://your-public-url.example.com
